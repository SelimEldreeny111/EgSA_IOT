# WIOT Platform v2 configuration. Copy to .env (never commit .env).
WIOT_ENV=development              # development | production
WIOT_HOST=127.0.0.1
WIOT_PORT=8000
WIOT_LOG_LEVEL=INFO
WIOT_LOG_JSON=false
WIOT_TIMEZONE=Africa/Cairo
WIOT_DATA_DIR=./data              # iot_data.db, messages_dbs/, command_lifecycle.db, flash_archive.db
# WIOT_ANALYTICS_DIR=./data/analytics
# WIOT_REPO_ROOT=../..            # project root scanned by the analytics pipeline
# WIOT_ANALYTICS_DATA_DIR=./data  # source databases for the analysis (exclude demo/simulated tenants)

# Security
WIOT_SECRET_KEY=replace-with-64-random-characters
WIOT_TOKEN_TTL_MINUTES=720
WIOT_COOKIE_SECURE=false          # true when served over HTTPS
WIOT_LOGIN_MAX_ATTEMPTS=8
WIOT_LOGIN_WINDOW_SECONDS=300

# Bootstrap passwords for built-in accounts (only used if the account is missing)
WIOT_ADMIN_PASSWORD=replace-me
WIOT_SUPERVISOR_PASSWORD=replace-me
WIOT_MONITOR_PASSWORD=replace-me

# MQTT ingestion (shared by all tenants)
WIOT_MQTT_AUTOCONNECT=false
WIOT_MQTT_HOST=broker.hivemq.com
WIOT_MQTT_PORT=1883
WIOT_MQTT_CLIENT_ID=wiot_platform
# WIOT_MQTT_USERNAME=
# WIOT_MQTT_PASSWORD=
WIOT_MQTT_AES_KEY_HEX=            # 32 hex chars; must match node/gateway AppSecrets

# Smart agriculture
# Basemap: any XYZ tile source (check the provider's terms; Esri World Imagery shown by default)
WIOT_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# WIOT_MAP_LABELS_URL=            # optional label overlay; empty disables it
WIOT_MAP_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics
WIOT_MAP_BACKDROP=22.2545,28.7215,15   # lat,lon,zoom behind the sign-in card
WIOT_WEATHER_ENABLED=true            # Open-Meteo forecast + ET0; sends only the farm centre coordinates
WIOT_SATELLITE_MSGS_PER_DAY=48       # default satellite-IoT message budget per node
WIOT_AUTOMATION_MIN_INTERVAL_S=120   # minimum gap between automatic valve commands per zone

# Release 2.1 — operations and field features
# WIOT_TLS_CERTFILE=C:\WIOT\tls\server.crt   # HTTPS served by the platform (set both files; turns on secure cookies)
# WIOT_TLS_KEYFILE=C:\WIOT\tls\server.key
WIOT_CLOCK_SYNC=true                 # queue STIME (next wake) when a node's clock is unset or drifts
WIOT_CLOCK_SYNC_DRIFT_S=120
WIOT_CLOCK_SYNC_MIN_INTERVAL_S=21600
# WIOT_NIGHT_FLOW_HOURS=00-04        # night-flow alert window, company local time; empty = off
WIOT_FROST_WARN_C=2
WIOT_HEAT_WARN_C=40
# WIOT_BACKUP_DIR=\fileserver\wiot-backups   # off-site folder for "python -m wiot backup"
# WIOT_BACKUP_PASSWORD=                       # set to encrypt backups; keep a copy outside the server
WIOT_BACKUP_KEEP=14
