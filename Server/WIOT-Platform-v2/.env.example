# WIOT Platform v2 configuration. Copy to .env (never commit .env).
WIOT_ENV=development              # development | production
WIOT_HOST=127.0.0.1
WIOT_PORT=8000
WIOT_LOG_LEVEL=INFO
WIOT_LOG_JSON=false
WIOT_TIMEZONE=Africa/Cairo
WIOT_DATA_DIR=./data              # iot_data.db, messages_dbs/, command_lifecycle.db, flash_archive.db
# WIOT_ANALYTICS_DIR=./data/analytics
# WIOT_REPO_ROOT=../..            # project root scanned by the analytics pipeline
# WIOT_ANALYTICS_DATA_DIR=./data  # source databases for the analysis (exclude demo/simulated tenants)

# Security
WIOT_SECRET_KEY=replace-with-64-random-characters
WIOT_TOKEN_TTL_MINUTES=720
WIOT_COOKIE_SECURE=false          # true when served over HTTPS
WIOT_LOGIN_MAX_ATTEMPTS=8
WIOT_LOGIN_WINDOW_SECONDS=300

# Bootstrap passwords for built-in accounts (only used if the account is missing)
WIOT_ADMIN_PASSWORD=replace-me
WIOT_SUPERVISOR_PASSWORD=replace-me
WIOT_MONITOR_PASSWORD=replace-me

# MQTT ingestion (shared by all tenants)
WIOT_MQTT_AUTOCONNECT=false
WIOT_MQTT_HOST=broker.hivemq.com
WIOT_MQTT_PORT=1883
WIOT_MQTT_CLIENT_ID=wiot_platform
# WIOT_MQTT_USERNAME=
# WIOT_MQTT_PASSWORD=
WIOT_MQTT_AES_KEY_HEX=            # 32 hex chars; must match node/gateway AppSecrets

# Smart agriculture
# Basemap: any XYZ tile source (check the provider's terms; Esri World Imagery shown by default)
WIOT_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# WIOT_MAP_LABELS_URL=            # optional label overlay; empty disables it
WIOT_MAP_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics
WIOT_MAP_BACKDROP=22.2545,28.7215,15   # lat,lon,zoom behind the sign-in card
WIOT_WEATHER_ENABLED=true            # Open-Meteo forecast + ET0; sends only the farm centre coordinates
WIOT_SATELLITE_MSGS_PER_DAY=48       # default satellite-IoT message budget per node
WIOT_AUTOMATION_MIN_INTERVAL_S=120   # minimum gap between automatic valve commands per zone

# Release 2.1 — operations and field features
# WIOT_TLS_CERTFILE=C:\WIOT\tls\server.crt   # HTTPS served by the platform (set both files; turns on secure cookies)
# WIOT_TLS_KEYFILE=C:\WIOT\tls\server.key
WIOT_CLOCK_SYNC=true                 # queue STIME (next wake) when a node's clock is unset or drifts
WIOT_CLOCK_SYNC_DRIFT_S=120
WIOT_CLOCK_SYNC_MIN_INTERVAL_S=21600
# WIOT_NIGHT_FLOW_HOURS=00-04        # night-flow alert window, company local time; empty = off
WIOT_FROST_WARN_C=2
WIOT_HEAT_WARN_C=40
# WIOT_BACKUP_DIR=\fileserver\wiot-backups   # off-site folder for "python -m wiot backup"
# WIOT_BACKUP_PASSWORD=                       # set to encrypt backups; keep a copy outside the server
WIOT_BACKUP_KEEP=14

# Release 2.2 — operations and data platform
WIOT_INGEST_BATCH_MS=250             # group telemetry writes (0 = write each message at once)
WIOT_MAINTENANCE_INTERVAL_S=600      # summaries, status sample, usage; retention and reports once a day
WIOT_RETENTION_DAYS=0                # raw-data retention default; 0 = keep forever, else >= 365 (per company too)
WIOT_STATUS_PUBLIC=true              # public /status page (service health only)
WIOT_CONFIG_WATCH=true               # re-send the acknowledged SRATE/STRAN when a node reports other intervals

# Release 2.3 — security, notifications, reports, integrations
# WIOT_PUBLIC_URL=https://wiot.example.org      # links in invitation e-mails; SSO redirect address
# Single sign-on (OpenID Connect); register <public URL>/api/v2/auth/oidc/callback at the provider
# WIOT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# WIOT_OIDC_CLIENT_ID=
# WIOT_OIDC_CLIENT_SECRET=
# WIOT_OIDC_AUTO_CREATE=false                   # create unknown users (role/company from claims or defaults)
# WIOT_OIDC_DEFAULT_ROLE=user
# WIOT_OIDC_DEFAULT_COMPANY=
# WIOT_OIDC_ROLE_CLAIM=
# WIOT_OIDC_COMPANY_CLAIM=
# WIOT_OIDC_ALLOWED_DOMAINS=["example.org"]
# Outgoing e-mail for alerts, invitations and monthly reports
# WIOT_SMTP_HOST=smtp.example.org
# WIOT_SMTP_PORT=587
# WIOT_SMTP_SECURITY=starttls                   # starttls | ssl | none
# WIOT_SMTP_USERNAME=
# WIOT_SMTP_PASSWORD=
# WIOT_SMTP_FROM=wiot@example.org
WIOT_REPORTS_AUTO=true               # build last month's report on the 1st and e-mail it to report channels
WIOT_FORWARD_QUEUE_MAX=5000          # integrations: readings waiting to be forwarded

# Release 2.5 — satellite and regional views
# WIOT_SENTINEL_CLIENT_ID=                      # Copernicus Data Space Ecosystem OAuth client (viewer layers, Sentinel-2 NDVI)
# WIOT_SENTINEL_CLIENT_SECRET=
WIOT_REGIONAL_MIN_FARMS=3            # regional dashboard hides areas with fewer farms

# Release 2.7 — Earth observation (Copernicus, EUMETSAT)
WIOT_SATELLITE_PROVIDER=auto         # auto = Sentinel Hub if the OAuth client is set; open = open AWS archive (no account); off
WIOT_SATELLITE_MAX_CLOUD=60          # passes with more scene cloud are not searched
WIOT_SATELLITE_OPEN_MAX_SCENES=6     # open archive: passes read per farm and run (each is a few MB)
# WIOT_EARTHSEARCH_URL=https://earth-search.aws.element84.com/v1
# WIOT_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# WIOT_EUMETSAT_KEY=                            # EUMETSAT API consumer key (https://api.eumetsat.int/api-key)
# WIOT_EUMETSAT_SECRET=                         # ... and consumer secret; search works without them
WIOT_EO_DOWNLOAD_MAX_MB=200          # largest EUMETSAT product the server downloads
# Satellite viewer: Sentinel Hub processing units its images may use per UTC day (0 = no limit). One map image
# costs about 3-15 units (more on large screens and for many-band layers); fit these to the monthly units of your
# Copernicus account (its dashboard shows them).
WIOT_VIEWER_DAILY_PU=1000            # the whole server (one Copernicus account for every company)
WIOT_VIEWER_COMPANY_DAILY_PU=400     # each company
WIOT_VIEWER_CACHE_MB=1024            # disk cache of drawn images (data/satellite/render)

# Release 2.6 — phone app, push, assistant
WIOT_WEB_PUSH=true                   # push alerts to installed dashboards (VAPID key created in data/)
WIOT_ASSISTANT_ENABLED=false         # optional AI assistant; needs: pip install -e ".[assistant]"
# WIOT_ASSISTANT_API_KEY=                       # Anthropic API key (or ANTHROPIC_API_KEY)
# WIOT_ASSISTANT_MODEL=claude-opus-5-5
WIOT_ASSISTANT_DAILY_SUMMARY=true
WIOT_ASSISTANT_MAX_PER_HOUR=30
