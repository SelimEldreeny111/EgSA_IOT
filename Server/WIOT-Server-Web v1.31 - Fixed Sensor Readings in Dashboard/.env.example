# Copy this file to .env or configure these values in the process environment.
# Never commit real passwords or encryption keys.
WIOT_FLASK_SECRET_KEY=replace-with-a-long-random-value
WIOT_ADMIN_PASSWORD=replace-me
WIOT_SUPERVISOR_PASSWORD=replace-me
WIOT_MONITOR_PASSWORD=replace-me
WIOT_COMPANY1_ADMIN_PASSWORD=replace-me
WIOT_COMPANY2_ADMIN_PASSWORD=replace-me
WIOT_COMPANY1_USER_PASSWORD=replace-me
WIOT_COMPANY2_USER_PASSWORD=replace-me
WIOT_DB_FILE=iot_data.db
# Set process environment variables before starting the Python server.
WIOT_MQTT_USE_TLS=false
WIOT_MQTT_BROKER_HOST=broker.hivemq.com
WIOT_MQTT_CA_FILE=
WIOT_MQTT_USERNAME=
WIOT_MQTT_PASSWORD=
