{
  "mqtt": {
    "broker": "mqtt.example.com",
    "port": 1883,
    "pub_topic": "EgSA/Company_1/1/telemetry",
    "sub_topic_1": "EgSA/Company_1/1/status",
    "sub_topic_2": "EgSA/Company_1/1/telemetry",
    "client_id": "wiot-test-client",
    "keepalive": 60,
    "use_tls": false,
    "username": null,
    "password": null,
    "reconnect_delay": 5,
