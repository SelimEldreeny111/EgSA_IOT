// F28 Four sensor simulator on one shared bus
digraph F28 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Configure COM port / bus\nAdd / clone / batch-add devices"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Validate unique slave addresses\nChoose fixed / dynamic signal values"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Simulation tick updates devices\nTotals + local Supmea calendar oracle"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Serial request with valid CRC?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Route to enabled device address\nValidate function / register range"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Encode that sensor register map\nApply selected fault / delay behavior"];
"g" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Reply with CRC / exception\nOr intentional silence / corruption"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Ignore noise / unknown address\nUpdate traffic counters"];
"i" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="GUI readings / logs / oracle CSV\nCompare node and simulator totals"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e"; "h";}
{rank=same; "f";}
{rank=same; "g"; "i";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="Yes"];
"d" -> "h" [label="No / no device"];
"e" -> "f" [];
"f" -> "g" [];
"c" -> "i" [];
"g" -> "d" [label="Next request", constraint="false", color="#8195A4", style="dashed"];
"h" -> "d" [label="Continue", constraint="false", color="#8195A4", style="dashed"];
}
