// F04 Sensor node cooperative main loop
digraph F04 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Loop progress checkpoint\nRemote idle gate if selected"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Pump commands and replies\nMQTT or LoRa [F11 / F16]"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Advance flash state machine\nCheck power / command priority"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Continue cycle or start sample?\nNew cycle yields to overdue Status"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Poll one enabled sensor\nFinish all groups [F05-F09]"];
"f" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Complete snapshot?"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Queue canonical flash sample\nNo half-finished sensor cycle"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Routine transmit due and safe?\nNo sensor / write / reply pending"];
"i" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Publish latest stored Status\nExplicit live fallback [F10]"];
"j" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Bulk packet last, at most one\nThen power service / WDT / idle"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e"; "h";}
{rank=same; "f"; "i";}
{rank=same; "g";}
{rank=same; "j";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="Allowed / yes"];
"e" -> "f" [];
"f" -> "g" [label="Yes"];
"f" -> "h" [label="Not yet", constraint="false", color="#8195A4", style="dashed"];
"d" -> "h" [label="No"];
"g" -> "h" [constraint="false", color="#8195A4", style="dashed"];
"h" -> "i" [label="Yes"];
"h" -> "j" [label="No"];
"i" -> "j" [];
"j" -> "a" [label="Next pass", constraint="false", color="#8195A4", style="dashed"];
}
