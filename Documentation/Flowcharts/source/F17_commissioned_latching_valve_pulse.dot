// F17 Commissioned latching valve pulse
digraph F17 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="VALVE command\n0 close / 1 open"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Enabled, pins available, commissioned\nand not busy?"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Already at commanded target?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Check minimum interval\nThen persist Unknown / verify"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Arm TIM10 cutoff first\nPB9 / PB15 set polarity"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Enable bridge with PC13 STBY\nISR or foreground cuts power"];
"g" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Pulse completed correctly?"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Set commanded Open / Closed\nPersist and ACK completion"];
"i" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Reject / Fault; bridge stays OFF\nInterrupted state remains Unknown"];
"j" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Accept without another pulse"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "i"; "j";}
{rank=same; "e";}
{rank=same; "f";}
{rank=same; "g";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "i" [label="No"];
"c" -> "j" [label="Yes"];
"c" -> "d" [label="No"];
"d" -> "e" [label="Verified"];
"d" -> "i" [label="Storage failure", constraint="false", color="#8195A4", style="dashed"];
"e" -> "f" [];
"f" -> "g" [];
"g" -> "h" [label="Yes"];
"g" -> "i" [label="No", constraint="false", color="#8195A4", style="dashed"];
}
