// F02 Choose the compiled product
digraph F02 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Read AppConfig.h\nPrivate deployment files stay local"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Which role?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Sensor node\nAPP_ROLE_SENSOR_NODE"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Gateway\nNo sensor polling or local archive"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Direct IP or LoRa uplink?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="WiFi or SIM modem\nOne selected external modem"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="LoRa node -> gateway\nUse role-specific UART pins"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Select each sensor true / false\nChoose unique addresses 1..247"];
"i" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Compile-time guards\nCheck modes, pins and buffers"];
"j" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Build the selected firmware"];
"k" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Reject invalid configuration\nCorrect it before flashing"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "d";}
{rank=same; "e"; "h";}
{rank=same; "f"; "g";}
{rank=same; "i";}
{rank=same; "j"; "k";}
"a" -> "b" [];
"b" -> "c" [label="Node"];
"b" -> "d" [label="Gateway"];
"c" -> "e" [];
"c" -> "h" [];
"e" -> "f" [label="Direct"];
"e" -> "g" [label="LoRa"];
"d" -> "f" [label="IP uplink + LoRa"];
"f" -> "i" [];
"g" -> "i" [];
"h" -> "i" [];
"i" -> "j" [label="Valid"];
"i" -> "k" [label="Invalid"];
}
