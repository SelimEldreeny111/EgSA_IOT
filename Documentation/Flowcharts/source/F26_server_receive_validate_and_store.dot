// F26 Server receive validate and store
digraph F26 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="MQTT RX frame\nBounded topic / payload size"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Check envelope, decrypt AES\nValidate PKCS7 / parse protobuf"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Topic, node ID, numbers\nand enum fields valid?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Status / live Telemetry\nSelect measured time / quality"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Flash metadata / history\nSeparate archive transaction"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Command echo\nInternal ACK14 is not live history"];
"g" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Store live readings / periods\nDeduplicate flow samples"];
"h" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Store archive row / transfer\nOnly then send HISTORY_ACK"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Emit scoped dashboard events\nDispatch queued command on Status"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Drop and log invalid message\nNo database / execution ACK effect"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "e"; "f"; "j";}
{rank=same; "g"; "h";}
{rank=same; "i";}
"a" -> "b" [];
"b" -> "c" [label="Decoded"];
"b" -> "j" [label="Decode failed"];
"c" -> "d" [label="Valid live"];
"c" -> "e" [label="Valid archive"];
"c" -> "f" [label="Valid command"];
"c" -> "j" [label="Invalid"];
"d" -> "g" [];
"e" -> "h" [];
"g" -> "i" [];
"h" -> "i" [];
"f" -> "i" [label="Operator echo only"];
}
