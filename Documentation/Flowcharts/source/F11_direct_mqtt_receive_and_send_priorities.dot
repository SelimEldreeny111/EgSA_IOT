// F11 Direct MQTT receive and send priorities
digraph F11 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Service IP transport\nConnect / MQTT loop if due"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Incoming command callback\nCheck topic / decode / target"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Internal HISTORY_ACK 14?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Advance archive cursor only\nNo reply-to-ACK loop"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Handle operator command\nDiscard queued stale routine Status"];
"f" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Reply requested / enabled?"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Queue correlated telemetry reply\nBefore routine publish work"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Drain priority reply first\nThen eligible routine Status"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Verified write / modem outcome\nReturn result to power manager"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "e";}
{rank=same; "f";}
{rank=same; "g";}
{rank=same; "h";}
{rank=same; "i";}
"a" -> "b" [label="RX callback"];
"b" -> "c" [];
"c" -> "d" [label="Yes"];
"c" -> "e" [label="No"];
"e" -> "f" [];
"f" -> "g" [label="Yes"];
"f" -> "h" [label="No"];
"g" -> "h" [];
"d" -> "h" [];
"a" -> "h" [label="No command"];
"h" -> "i" [];
"i" -> "a" [label="Next pass", constraint="false", color="#8195A4", style="dashed"];
}
