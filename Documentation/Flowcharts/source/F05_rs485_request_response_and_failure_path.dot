// F05 RS485 request response and failure path
digraph F05 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Select enabled sensor\nUse its configured slave ID"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Ensure silent interval\nDE HIGH, send Modbus request"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="DE LOW and wait for response\nService commands in idle gaps"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Valid ID, function, length\nand CRC / response status?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Decode this sensor map\nCheck numeric validity"];
"f" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Transport retry allowed?"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Retry bounded TUF / Supmea\nAt most two read attempts"];
"h" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Replace failed group with zero\nKeep validity false"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Update runtime snapshot\nContinue next sensor / loop"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e"; "f";}
{rank=same; "g"; "h";}
{rank=same; "i";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="Success"];
"d" -> "f" [label="Failure"];
"e" -> "i" [];
"f" -> "g" [label="Yes"];
"g" -> "b" [label="Next attempt", constraint="false", color="#8195A4", style="dashed"];
"f" -> "h" [label="No / exception"];
"h" -> "i" [];
}
