// F18 Watchdog reset causes and two counters
digraph F18 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Boot: snapshot reset flags\nPreserve Standby classification"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="IWDG flag set?"];
"c" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Increment WDT counter\nRecover last stored WDT stage"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Power-on / brownout only\nand not Standby / warm reset?"];
"e" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Increment power counter"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Other reset: do not increment\nPower/WDT cause counter"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Arm nominal 30 s IWDG\nFeed only at progress checkpoints"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Software keeps progressing?"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Continue normal application"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="No feed -> IWDG hardware reset\nReturn through boot classification"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "d";}
{rank=same; "e"; "f";}
{rank=same; "g";}
{rank=same; "h";}
{rank=same; "i"; "j";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "d" [label="No"];
"d" -> "e" [label="Yes"];
"d" -> "f" [label="No"];
"c" -> "g" [];
"e" -> "g" [];
"f" -> "g" [];
"g" -> "h" [];
"h" -> "i" [label="Yes"];
"h" -> "j" [label="Stuck"];
"j" -> "a" [label="Reset", constraint="false", color="#8195A4", style="dashed"];
}
