// F29 Verify document and release the project
digraph F29 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Authorized project change\nPreserve deployment secrets"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Regenerate matching schemas\nIf the protocol changed"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Run native / server / simulator\nAnd cross-component regression suites"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Build firmware profiles\nCheck flash load / RAM / EEPROM area"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Checks pass?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Update guides / Doxygen / flows\nSynchronize verified final folder"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Create new feature branch\nPublish complete change and verify ref"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Run physical acceptance\nSupply, sensors, RF, power, flash soak"];
"i" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Fix defect and repeat\nDo not claim hardware validation"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e";}
{rank=same; "f"; "i";}
{rank=same; "g";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [];
"e" -> "f" [label="Yes"];
"e" -> "i" [label="No"];
"i" -> "c" [label="Recheck", constraint="false", color="#8195A4", style="dashed"];
"f" -> "g" [];
"g" -> "h" [];
}
