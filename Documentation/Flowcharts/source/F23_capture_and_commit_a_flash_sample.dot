// F23 Capture and commit a flash sample
digraph F23 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="All sensor groups completed"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Enabled, ready, trusted time\nand unexpired generation?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Encode canonical Telemetry\nNo command / history wrapper"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Queue has room and log not full?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Allocate / verify current sector\nProgram two body pages"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Poll completion in later passes\nRead back body / CRC"];
"g" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Write commit marker last\nUpdate count / latest sequence"];
"h" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Count skipped / dropped sample\nKeep reporting with honest source"];
"i" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="I/O / status / timeout failure\nLatch Fault, no silent success"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "h";}
{rank=same; "d";}
{rank=same; "e";}
{rank=same; "f";}
{rank=same; "g"; "i";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "h" [label="No"];
"c" -> "d" [];
"d" -> "e" [label="Yes"];
"d" -> "h" [label="No", constraint="false", color="#8195A4", style="dashed"];
"e" -> "f" [];
"f" -> "g" [label="Verified"];
"f" -> "i" [label="Failed"];
}
