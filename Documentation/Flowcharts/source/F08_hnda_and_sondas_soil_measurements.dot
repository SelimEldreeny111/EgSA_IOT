// F08 HNDA and Sondas soil measurements
digraph F08 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Poll next enabled soil sensor"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="HNDA / Honde\nFC03 from 0x0000, 2 registers"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Sondas\nFC03 from 0x0000, 3 registers"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Successful response?"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Successful response?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Signed temperature / 10\nUnsigned moisture / 10"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Temperature / 10, moisture / 10\nEC with configured scale"];
"h" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Zero fields + validity false"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="HNDA -> soil_* fields\nSondas -> ec_* fields"];
{rank=same; "a";}
{rank=same; "b"; "c";}
{rank=same; "d"; "e";}
{rank=same; "f"; "g"; "h";}
{rank=same; "i";}
"a" -> "b" [label="HNDA"];
"a" -> "c" [label="Sondas"];
"b" -> "d" [];
"c" -> "e" [];
"d" -> "f" [label="Yes"];
"e" -> "g" [label="Yes"];
"d" -> "h" [label="No"];
"e" -> "h" [label="No"];
"f" -> "i" [];
"g" -> "i" [];
"h" -> "i" [];
}
