// F03 Boot and reset initialization
digraph F03 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Power / reset / RTC Standby exit"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Safe valve pins when available\nSnapshot RCC / Standby cause"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Valid pending sleep handoff?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EEEAF8", fontcolor="#4B416D", color="#A69BC7", label="Enter / continue RTC Standby\nBefore arming the IWDG [F21]"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Classify cause, update counters\nArm hardware WDT [F18]"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Sensor node setup_Init\nRTC, ADC, transport and sensors"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Gateway setup\nLoRa and IP / MQTT only"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Begin archive recovery\nInitialize power manager"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Install command-service hook\nEnter cooperative loop"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "e";}
{rank=same; "f"; "g";}
{rank=same; "h";}
{rank=same; "i";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [label="Yes, deadline future"];
"d" -> "a" [label="RTC wake", constraint="false", color="#8195A4", style="dashed"];
"c" -> "e" [label="No / elapsed"];
"e" -> "f" [label="Node"];
"e" -> "g" [label="Gateway"];
"f" -> "h" [];
"g" -> "h" [];
"h" -> "i" [];
}
