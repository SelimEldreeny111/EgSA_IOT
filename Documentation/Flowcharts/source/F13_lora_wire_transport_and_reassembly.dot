// F13 LoRa wire transport and reassembly
digraph F13 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Encrypted logical payload\nAt most 640 bytes buffer capacity"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Split when required\n27 data bytes per fragment"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="TX physical frame + CRC\nWait for module AUX readiness"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Required uplink fragment ACK?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Receive / ACK or bounded retry\nNo ACK -> send failure"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="RX: check wire version, network\nLength, source and CRC"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Reassemble by source / message\n32-bit received mask"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Complete length + logical CRC?"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Queue complete application frame"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Discard / expire incomplete data\nIncrement diagnostics"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "f";}
{rank=same; "d"; "g";}
{rank=same; "e"; "h";}
{rank=same; "i"; "j";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="Node uplink"];
"d" -> "i" [label="No transport ACK\nrequired"];
"e" -> "c" [label="Retry if allowed", constraint="false", color="#8195A4", style="dashed"];
"e" -> "i" [label="Accepted"];
"c" -> "f" [label="Radio peer", constraint="false", color="#8195A4", style="dashed"];
"f" -> "g" [label="Valid"];
"f" -> "j" [label="Invalid"];
"g" -> "h" [];
"h" -> "i" [label="Yes"];
"h" -> "j" [label="Bad / timed out"];
}
