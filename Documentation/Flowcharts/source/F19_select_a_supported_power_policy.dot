// F19 Select a supported power policy
digraph F19 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Choose controller mode\nThen selected radio policy"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Gateway role?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Controller NORMAL required\nRadio stays ready"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="NORMAL\nController / selected radio normal"];
"e" [shape="box", style="rounded,filled", fillcolor="#EEEAF8", fontcolor="#4B416D", color="#A69BC7", label="REMOTE_WAKE\nCPU Sleep, radio NORMAL [F20]"];
"f" [shape="box", style="rounded,filled", fillcolor="#EEEAF8", fontcolor="#4B416D", color="#A69BC7", label="POWER_DOWN / QUEUED\nRTC Standby + sleeping radio [F21]"];
"g" [shape="box", style="rounded,filled", fillcolor="#EEEAF8", fontcolor="#4B416D", color="#A69BC7", label="LORA_WOR\nSTM32 Stop + radio Mode 2 [F22]"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Selected hardware and policies\npass compile-time checks?"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Run chosen policy"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Reject configuration\nFix role, pins or radio pairing"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "d"; "e"; "f"; "g";}
{rank=same; "h";}
{rank=same; "i"; "j";}
"a" -> "b" [];
"b" -> "c" [label="Gateway"];
"b" -> "d" [label="Node normal"];
"b" -> "e" [label="Node remote"];
"b" -> "f" [label="Node periodic / queued"];
"b" -> "g" [label="Node WOR"];
"c" -> "h" [];
"d" -> "h" [];
"e" -> "h" [];
"f" -> "h" [];
"g" -> "h" [];
"h" -> "i" [label="Yes"];
"h" -> "j" [label="No"];
}
