// F27 Server users dashboard reports and isolation
digraph F27 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Start server / initialize databases\nInitial users require local secrets"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Login and verify password hash\nEstablish role / company session"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="User request authorized?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Live dashboard / history / graphs\nThresholds, map and node details"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Admin: commands, user / node config\nSupervisor: shared broker controls"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Flash archive status / progress\nStored records and CSV export"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Scope every query / event\nCompany + region + node"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Return API / Socket.IO view\nSafe text rendering / bounded history"];
"i" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Reject unauthorized request\nNo cross-company side effect"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "e"; "f"; "i";}
{rank=same; "g";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [label="Read view"];
"c" -> "e" [label="Permitted action"];
"c" -> "f" [label="Archive query"];
"c" -> "i" [label="Denied"];
"d" -> "g" [];
"e" -> "g" [];
"f" -> "g" [];
"g" -> "h" [];
}
