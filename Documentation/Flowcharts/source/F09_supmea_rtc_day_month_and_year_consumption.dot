// F09 Supmea RTC day month and year consumption
digraph F09 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Forward total and sample UTC\nLoad saved baseline if available"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="RTC trusted and calendar valid?"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="No usable baseline?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Set baseline, zero / partial totals\nPersist and wait for next sample"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Handle backward clock / counter\nNoise clamp, reset or anomaly"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Accepted delta liters\nCurrent minus previous total"];
"g" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Period boundary crossed?"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Add full delta to same buckets"];
"i" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Allocate current-period share\nProportional time, Estimated"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Return unavailable / uncertain\nPreserve internal history"];
"k" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Persist backup + checkpoints\nPublish m3 and quality"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "j";}
{rank=same; "d"; "e";}
{rank=same; "f";}
{rank=same; "g";}
{rank=same; "h"; "i";}
{rank=same; "k";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "j" [label="No"];
"c" -> "d" [label="First sample"];
"c" -> "e" [label="Baseline exists"];
"e" -> "f" [label="Normal accepted change"];
"e" -> "k" [label="Reset / anomaly / time\nevent"];
"f" -> "g" [];
"g" -> "h" [label="No"];
"g" -> "i" [label="Yes"];
"h" -> "k" [];
"i" -> "k" [];
"d" -> "k" [];
"j" -> "k" [];
}
