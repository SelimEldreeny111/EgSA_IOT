// F20 Remote wake with normal connected modem
digraph F20 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="REMOTE_WAKE active / reachable idle"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="UART command, app deadline,\nreply / flash work or WAKE lease?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Resume foreground work\nDo not force unrelated deadlines"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Service commands first\nThen only due sample / send work"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="No due / busy work\nand no active WAKE lease?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Reachable idle\nNormal modem, UART / SysTick alive"];
"g" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="WFI light CPU Sleep\nInterrupt / periodic poll resumes"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Keep application active\nPreserve pending operations"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e";}
{rank=same; "f"; "h";}
{rank=same; "g";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "f" [label="No"];
"c" -> "d" [];
"d" -> "e" [];
"e" -> "f" [label="Yes"];
"e" -> "h" [label="No"];
"h" -> "b" [label="Next pass", constraint="false", color="#8195A4", style="dashed"];
"f" -> "g" [];
"g" -> "b" [label="UART / tick / deadline", constraint="false", color="#8195A4", style="dashed"];
}
