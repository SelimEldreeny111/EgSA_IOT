// F07 Supmea live data and cumulative totals
digraph F07 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Begin Supmea poll\nZero a new result structure"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="FC03 totals at decimal 90\n6 registers: forward / reverse / net"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="FC03 live block at decimal 98\n10 registers: flow, velocity, alarms"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Each group valid and finite?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Normalize volume flow to m3/h\nConvert cumulative m3 to liters"];
"f" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Zero only failed groups\nMark them unavailable"];
"g" [shape="box", style="rounded,filled", fillcolor="#EEEAF8", fontcolor="#4B416D", color="#A69BC7", label="Valid forward total + trusted RTC\nUpdate accumulator [F09]"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Map live / totals / periods\nwith separate quality flags"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e"; "f";}
{rank=same; "g";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="For valid groups"];
"d" -> "f" [label="For failed groups"];
"e" -> "g" [];
"f" -> "h" [];
"g" -> "h" [];
}
