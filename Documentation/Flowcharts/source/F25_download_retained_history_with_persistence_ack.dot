// F25 Download retained history with persistence ACK
digraph F25 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Direct FLASH_TODAY / resume\nRequire retained trusted log"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Freeze day, generation, final seq\nCount matching valid records"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Read next CRC-valid sample\nAttach request / index / total"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Send after priority work\nServer commits scoped row [F26]"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Matching internal CMD14 received?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Advance cursor\nSend next row or successful End"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Bounded retry same row\nThen ACK-timeout terminal result"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Cancel / expiry / read error?"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Send explicit terminal result\nRelease after ACK / bounded timeout"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "h";}
{rank=same; "d";}
{rank=same; "e";}
{rank=same; "f"; "g";}
{rank=same; "i";}
"a" -> "b" [];
"b" -> "c" [];
"b" -> "i" [label="Empty result"];
"c" -> "d" [];
"d" -> "e" [];
"e" -> "f" [label="Yes"];
"e" -> "g" [label="Timeout"];
"g" -> "d" [label="Attempts remain", constraint="false", color="#8195A4", style="dashed"];
"g" -> "i" [label="Exhausted"];
"f" -> "c" [label="More rows", constraint="false", color="#8195A4", style="dashed"];
"f" -> "i" [label="End"];
"b" -> "h" [label="During job"];
"h" -> "i" [label="Yes"];
"h" -> "c" [label="No", constraint="false", color="#8195A4", style="dashed"];
}
