// F12 WiFi SIM connection and retry recovery
digraph F12 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="A physical connection attempt"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Selected modem?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="WiFi: firmware credentials\nThen saved / operator fallback"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="SIM: registration then GPRS\nUse configured APN"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Network connected?"];
"f" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Clear failure count / stage\nContinue MQTT connection"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Count returned network failure"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Reached 10 failures in stage?"];
"i" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Keep bounded retry policy"];
"j" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="First set: reset modem RST\nStart second set of 10"];
"k" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Second set: reset modem\nRequest controller reset"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "d";}
{rank=same; "e";}
{rank=same; "f"; "g";}
{rank=same; "h";}
{rank=same; "i"; "j"; "k";}
"a" -> "b" [];
"b" -> "c" [label="ESP8266"];
"b" -> "d" [label="SIM800"];
"c" -> "e" [];
"d" -> "e" [];
"e" -> "f" [label="Yes"];
"e" -> "g" [label="No"];
"g" -> "h" [];
"h" -> "i" [label="Not yet"];
"i" -> "a" [label="Retry", constraint="false", color="#8195A4", style="dashed"];
"h" -> "j" [label="Stage 1 threshold"];
"j" -> "a" [label="Retry stage 2", constraint="false", color="#8195A4", style="dashed"];
"h" -> "k" [label="Stage 2 threshold"];
}
