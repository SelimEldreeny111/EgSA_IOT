// F21 Periodic and queued RTC Standby
digraph F21 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Fresh sample and successful report"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Command window\nPeriodic or longer queued policy"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Window elapsed, no active lease\ntransport / flash idle and RTC valid?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Keep awake / retry preparation\nQueued command can hold WAKE lease"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Put radio into supported sleep\nPut idle flash into deep power-down"];
"f" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Store checked RTC sleep request\nLimit deadline by flash expiry"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Software reset\nEarly boot before IWDG [F03]"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Enter Standby until RTC deadline\nWake is a new startup"];
"i" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Abort failed handoff\nRestore active scheduling"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "e";}
{rank=same; "f";}
{rank=same; "g"; "i";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [label="Not ready"];
"d" -> "c" [label="Later pass", constraint="false", color="#8195A4", style="dashed"];
"c" -> "e" [label="Ready"];
"e" -> "f" [];
"f" -> "g" [label="Verified"];
"f" -> "i" [label="Failure"];
"g" -> "h" [];
"h" -> "a" [label="RTC boot + work", constraint="false", color="#8195A4", style="dashed"];
}
