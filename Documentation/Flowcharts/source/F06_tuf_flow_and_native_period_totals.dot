// F06 TUF flow and native period totals
digraph F06 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Begin TUF poll\nZero a new result structure"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="FC03 at 0x0000, 6 registers\nFlow and velocity"];
"c" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Core reply / floats valid?"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Read day / month\n0x007C, 4 registers"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Read yearly integer + fraction\n0x0090, 4 registers"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Read optional error code\n0x0047, 1 register"];
"g" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Publish zero invalid core\nDo not reuse last reading"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Set independent live / period\nvalidity and TUF source"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d"; "g";}
{rank=same; "e";}
{rank=same; "f";}
{rank=same; "h";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [label="Yes"];
"c" -> "g" [label="No"];
"d" -> "e" [];
"e" -> "f" [];
"f" -> "h" [];
"g" -> "h" [];
}
