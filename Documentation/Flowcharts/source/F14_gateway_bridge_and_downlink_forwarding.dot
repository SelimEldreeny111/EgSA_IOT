// F14 Gateway bridge and downlink forwarding
digraph F14 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Gateway loop\nDrain LoRa UART first"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Fragment transaction active?"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Defer MQTT work\nMaintain fragment turnaround"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Service subscribed MQTT routes\nDirect + regional broadcast"];
"e" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Complete uplink frame available?"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Status -> /status\nSystem telemetry -> /data"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Build company / region / source\nPublish encrypted body unchanged"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Parse direct / broadcast topic\nForward radio command [F16]"];
"i" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="WOR configured at gateway?\nMode-1 probe before command"];
"j" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Finish bridge work\nRestore Mode 0 after command"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "d";}
{rank=same; "e"; "h";}
{rank=same; "f"; "i";}
{rank=same; "g";}
{rank=same; "j";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "d" [label="No"];
"c" -> "e" [];
"d" -> "e" [];
"e" -> "f" [label="Supported uplink"];
"f" -> "g" [];
"d" -> "h" [label="Downlink callback"];
"h" -> "i" [];
"i" -> "j" [label="Probe or normal TX"];
"g" -> "j" [];
"e" -> "j" [label="No frame"];
"j" -> "a" [label="Next pass", constraint="false", color="#8195A4", style="dashed"];
}
