// F30 Active release and separate firmware ports
digraph F30 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Select project to build"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Arduino STM32F401\nActive release documented here"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="ESP32 Arduino port\nSeparate architecture snapshot"];
"d" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="STM32CubeIDE HAL port\nSeparate native implementation"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Current sensing / commands / WDT\nPower modes / RTC totals / SPI log"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Remapped three UART roles\nExternal ESP8266 / SIM retained"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="SensorNode / LoRaGateway\nHAL startup, UART rings, drivers"];
"h" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Use this book F01-F29\nfor active release behavior"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Inspect own config and schema\nDo not assume current feature parity"];
{rank=same; "a";}
{rank=same; "b"; "c"; "d";}
{rank=same; "e"; "f"; "g";}
{rank=same; "h"; "i";}
"a" -> "b" [];
"a" -> "c" [];
"a" -> "d" [];
"b" -> "e" [];
"c" -> "f" [];
"d" -> "g" [];
"e" -> "h" [];
"f" -> "i" [];
"g" -> "i" [];
}
