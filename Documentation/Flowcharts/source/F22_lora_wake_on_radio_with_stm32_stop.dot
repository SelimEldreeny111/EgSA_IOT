// F22 LoRa wake on radio with STM32 Stop
digraph F22 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Work done, receive window elapsed\nNo lease / busy transfer / write"];
"b" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Enter radio Mode 2\nM0 LOW, M1 HIGH; verify readiness"];
"c" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Arm UART RX falling-edge wake\nSet nearest RTC alarm; flash sleeps"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Safe to enter Stop?\nCheck pending edge / UART / RTC"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="STM32 Stop with RAM retained"];
"f" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Wake source?\nRestore clocks before UART work"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="UART activity: return Mode 0\nReceive command; data not yet proven"];
"h" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="RTC heartbeat: service WDT\nIf no deadline, return to Stop"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="SRATE / STRAN / flash expiry due\nRun only the due work"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Activity or setup failure\nStay active / preserve received bytes"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c";}
{rank=same; "d";}
{rank=same; "e"; "j";}
{rank=same; "f";}
{rank=same; "g"; "h"; "i";}
"a" -> "b" [];
"b" -> "c" [];
"c" -> "d" [];
"d" -> "e" [label="Yes"];
"d" -> "j" [label="No"];
"e" -> "f" [];
"f" -> "g" [label="RX"];
"f" -> "h" [label="Heartbeat"];
"f" -> "i" [label="Deadline"];
"h" -> "c" [label="Still waiting", constraint="false", color="#8195A4", style="dashed"];
"g" -> "a" [label="After work / window", constraint="false", color="#8195A4", style="dashed"];
}
