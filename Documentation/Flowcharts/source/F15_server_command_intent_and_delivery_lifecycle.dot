// F15 Server command intent and delivery lifecycle
digraph F15 {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.25", ranksep="0.25", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=17, margin="0.13,0.09", penwidth=1.05];
edge [fontname="Arial", fontsize=14, color="#587083", fontcolor="#405C70", arrowsize=0.72, penwidth=1.15];
"a" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Authenticated operator request\nCompany / region / node / action"];
"b" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Authorized scope and valid data?"];
"c" [shape="cylinder", style="filled", fillcolor="#E1F2ED", fontcolor="#214B43", color="#7DA89B", label="Create command journal intent\nRequest ID, actor and TTL"];
"d" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Deliver now or next Status?"];
"e" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Claim immediately when online"];
"f" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Wait for matching node Status\nThen atomically claim"];
"g" [shape="box", style="rounded,filled", fillcolor="#EAF2F8", fontcolor="#163B55", color="#91A9BC", label="Publish encrypted command\nRecord broker receipt separately"];
"h" [shape="diamond", style="filled", fillcolor="#FFF1D2", fontcolor="#513F12", color="#C4A35E", label="Matching node reply?"];
"i" [shape="box", style="rounded,filled", fillcolor="#173E5B", fontcolor="white", color="#173E5B", label="Accepted / rejected by node\nStore execution receipt"];
"j" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Bounded rate retry or unknown\nExpiry / superseded intent retained"];
"k" [shape="box", style="rounded,filled", fillcolor="#FBE9E9", fontcolor="#733C3C", color="#C49393", label="Reject invalid / unauthorized request"];
{rank=same; "a";}
{rank=same; "b";}
{rank=same; "c"; "k";}
{rank=same; "d";}
{rank=same; "e"; "f";}
{rank=same; "g";}
{rank=same; "h";}
{rank=same; "i"; "j";}
"a" -> "b" [];
"b" -> "c" [label="Yes"];
"b" -> "k" [label="No"];
"c" -> "d" [];
"d" -> "e" [label="Now"];
"d" -> "f" [label="Next wake"];
"e" -> "g" [];
"f" -> "g" [];
"g" -> "h" [];
"h" -> "i" [label="Correlated reply"];
"h" -> "j" [label="Timeout / no reply"];
}
