#include "AppConfig.h"

// Copy this file to AppConfig.cpp and replace the placeholder values locally.
// AppConfig.cpp is intentionally ignored by Git because it contains secrets.

#if defined(USE_SIM800)
const char kApn[] = "YOUR_APN";
const char kNetworkUser[] = "";
const char kNetworkPassword[] = "";
#elif defined(USE_ESP8266)
const char kWifiSsid[] = "YOUR_WIFI_SSID";
const char kWifiPassword[] = "YOUR_WIFI_PASSWORD";
#endif

const char kMqttServer[] = "mqtt.example.com";
const char kMqttClientId[] = "wiot-" APP_MQTT_COMPANY "-" APP_MQTT_REGION "-" APP_MQTT_STRINGIFY(APP_NODE_ID);

const char kMqttCompanyTopicPrefix[] = APP_MQTT_PREFIX;
// Lowercase topics derive from APP_MQTT_COMPANY, APP_MQTT_REGION and APP_NODE_ID.
// The historical prefix symbol now includes both company and region.
const char kMqttPublishTopicStatus[] = APP_MQTT_PREFIX "/" APP_MQTT_STRINGIFY(APP_NODE_ID) "/status";
const char kMqttPublishTopicTlm[] = APP_MQTT_PREFIX "/" APP_MQTT_STRINGIFY(APP_NODE_ID) "/data";
const char kMqttCommandTopic[] = APP_MQTT_PREFIX "/" APP_MQTT_STRINGIFY(APP_NODE_ID) "/cmd";
const char kMqttBroadcastTopic[] = APP_MQTT_PREFIX "/broadcast";
const char kMqttGatewayCommandWildcardTopic[] = APP_MQTT_PREFIX "/+/cmd";
