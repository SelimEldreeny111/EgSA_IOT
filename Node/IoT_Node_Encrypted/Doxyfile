# WIOT STM32F401 Arduino firmware API reference.
# Run from this directory: doxygen Doxyfile
PROJECT_NAME           = "WIOT STM32F401 Arduino Node"
PROJECT_BRIEF          = "Firmware architecture and API reference"
PROJECT_NUMBER         = "2026-10-28 regional MQTT and WOR wake diagnostics"
OUTPUT_DIRECTORY       = Documentation/Doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

INPUT                  = DOXYGEN_MAINPAGE.md \
                         README.md \
                         POWER_DOWN_MODE_USER_GUIDE.md \
                         FLOW_METER_PROFILES_AND_CONSUMPTION_GUIDE.md \
                         NEW_POWER_MODES_USER_GUIDE.md \
                         LORA_WOR_DIAGNOSTIC_GUIDE.md \
                         LORA_WOR_RX_WAKE_GUIDE.md \
                         REMOTE_WAKE_USER_GUIDE.md \
                         REMOTE_WAKE_APP_SCHEDULE_GUIDE.md \
                         SENSOR_UNAVAILABLE_ZERO_GUIDE.md \
                         SIM_MQTT_COMMAND_PRIORITY_FIX_GUIDE.md \
                         COMMAND_ACK_CONFIG_USER_GUIDE.md \
                         SUPMEA_RTC_RESET_FIX_AND_TEST_GUIDE.md \
                         WATCHDOG_RECOVERY_AND_TEST_GUIDE.md \
                         NETWORK_RECOVERY_USER_GUIDE.md \
                         WDT_RESET_COUNTER_GUIDE.md \
                         RESET_COUNTERS_AND_SUPMEA_REFERENCE_GUIDE.md \
                         RADIO_AND_VOLTAGE_GUIDE.md \
                         LATCHING_VALVE_USER_GUIDE.md \
                         LATCHING_VALVE_VERIFICATION.md \
                         IoT_Node_Encrypted.ino \
                         src
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.ino *.md
RECURSIVE              = YES
EXCLUDE                = src/third_party \
                         src/generated \
                         src/config/AppConfig.cpp \
                         src/config/AppSecrets.h \
                         src/config/AppSecrets.example.h
EXCLUDE_PATTERNS       = */.venv/* */build/* */dist/*
EXTENSION_MAPPING      = ino=C++
USE_MDFILE_AS_MAINPAGE = DOXYGEN_MAINPAGE.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT
GENERATE_HTML          = YES
HTML_OUTPUT           = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT            = xml

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 50

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = Documentation/Doxygen/warnings.log
QUIET                  = YES

INPUT += REGIONAL_MQTT_TOPICS_GUIDE.md
INPUT += ../../Documentation/Validation/LORA_WOR_9MA_BENCH_RESULT_20261029.md
INPUT += ../../Documentation/Validation/LORA_WOR_RX_WAKE_VERIFICATION_20261029.md
